{
    "namespace": "dark_ui",

    "dark_button": {
        "type": "panel",
        "size": ["100%", 23],
        "controls": [
            {
                "inner": {
                    "type": "stack_panel",
                    "orientation": "horizontal",
                    "size": ["100%", 30],
                    "anchor_from": "left_middle",
                    "anchor_to": "left_middle",
                    "controls": [
                        {
                            "form_button": {
                                "type": "button",
                                "$pressed_button_name": "button.form_button_click",
                                "size": ["8.5%", 20],
                                "sound_name": "random.click",
                                "default_control": "default",
                                "hover_control": "hover",
                                "pressed_control": "pressed",
                                "button_mappings": [
                                    {
                                        "from_button_id": "button.menu_select",
                                        "to_button_id": "$pressed_button_name",
                                        "mapping_type": "pressed"
                                    },
                                    {
                                        "from_button_id": "button.menu_ok",
                                        "to_button_id": "$pressed_button_name",
                                        "mapping_type": "focused"
                                    }
                                ],
                                "controls": [
                                    {
                                        "default": {
                                            "type": "image",
                                            "texture": "textures/ui/buttons/defaultv2",
                                            "size": ["100%", "100%"]
                                        }
                                    },
                                    {
                                        "hover": {
                                            "type": "image",
                                            "texture": "textures/ui/buttons/defaultv3",
                                            "size": ["100%", "100%"]
                                        }
                                    },
                                    {
                                        "pressed": {
                                            "type": "image",
                                            "texture": "textures/ui/buttons/defaultv3",
                                            "size": ["100%", "100%"]
                                        }
                                    },
                                    {
                                        "label": {
                                            "type": "label",
                                            "text": "#form_button_text",
                                            "font_type": "MinecraftTen",
                                            "shadow": true,
                                            "font_scale_factor": 1.3,
                                            "color": [0.75, 0.75, 0.75],
                                            "layer": 2,
                                            "anchor_from": "left_middle",
                                            "anchor_to": "left_middle",
                                            "offset": [25, -2.5],
                                            "bindings": [
                                                {
                                                    "binding_name": "#form_button_text",
                                                    "binding_type": "collection",
                                                    "binding_collection_name": "form_buttons"
                                                }
                                            ]
                                        }
                                    }
                                ],
                                "bindings": [
                                    {
                                        "binding_type": "collection_details",
                                        "binding_collection_name": "form_buttons"
                                    }
                                ]
                            }
                        }
                    ]
                }
            }
        ]
    },

    "dark_label": {
        "type": "panel",
        "size": ["100%","100%c"],
        "controls": [
            {
                "label_text": {
                    "type": "label",
                    "size": ["100%","default"],
                    "anchor_from": "top_left",
                    "anchor_to": "top_left",
                    "offset": [6,-20],
                    "text": "#form_button_text",
                    "font_type": "MinecraftTen",
                    "font_scale_factor": 1.2,
                    "bindings": [
                        {
                            "binding_name": "#form_button_text",
                            "binding_type": "collection",
                            "binding_collection_name": "form_buttons"
                        }
                    ]
                }
            }
        ]
    },

    "my_dark_form": {
        "type": "stack_panel",
        "size": [290,200],
        "controls": [
            {
                "title": {
                    "type": "image",
                    "texture": "textures/ui/menus/title/header_blueDark",
                    "size": ["91%","9.5%"],
                    "offset": [0, -40],
                    "controls": [
                        {
                            "content": {
                                "type": "label",
                                "text": "#text",
                                "font_type": "MinecraftTen",
                                "font_scale_factor": 1.05,
                                "offset":  [0,"-12.5%"],
                                "bindings": [
                                    {
                                        "binding_name": "#title_text",
                                        "binding_type": "global"
                                    },
                                    {
                                        "binding_type": "view",
                                        "source_property_name": "(#title_text - ':status:')",
                                        "target_property_name": "#text"
                                    }
                                ]
                            }
                        },
                        {
                            "close_content": {
                                "type": "image",
                                "anchor_from": "right_middle",
                                "anchor_to": "right_middle",
                                "offset": [26, 0],
                                "layer": 1,
                                "texture": "textures/ui/menus/content/content2",
                                "size": [23, 19],
                                "controls": [
                                    {
                                        "close_button@common.close_button": {
                                            "anchor_from": "right_middle",
                                            "anchor_to": "right_middle",
                                            "offset": ["-3%",-1],
                                            "layer": 2,
                                            "controls": [
                                                {
                                                    "pressed_default@common.close_button_panel": {
                                                        "$close_button_texture": "textures/ui/menus/closer/default"
                                                    }
                                                },
                                                {
                                                    "hover@common.close_button_panel": {
                                                        "$close_button_texture": "textures/ui/menus/closer/interact"
                                                    }
                                                }
                                        ]
                        }
                                    }
                                ]
                            }
                        }
                    ]
                }
            },
            {
                "header_gap": {
                    "type": "panel",
                    "size": ["100%", 1.5]
                }
            },
            {
                "background": {
                    "type": "panel",
                    "size": ["100%","fill"],
                    "controls": [
                        {
                            "bg": {
                                "type": "image",
                                "texture": "textures/ui/menus/background/blue_dark",
                                "size": ["100%","100%"],
                                "alpha": 0.9,
                                "layer": -1
                            }
                        },
                        {
                            "inner": {
                                "type": "panel",
                                "size": ["45%", "100%"],
                                "anchor_from": "right_middle",
                                "anchor_to": "right_middle",
                                "offset": [-4, 0],
                                "controls": [
                                    {
                                        "body_panel": {
                                            "type": "panel",
                                            "size": ["90%", "50%"],
                                            "anchor_from": "top_middle",
                                            "anchor_to": "top_middle",
                                            "offset": [0,8],
                                            "controls": [
                                                {
                                                    "body_image": {
                                                        "type": "image",
                                                        "texture": "textures/ui/menus/content/blue_content2",
                                                        "size": ["100%", "100%"],
                                                        "layer": 1
                                                    }
                                                },
                                                {
                                                    "body_text": {
                                                        "type": "label",
                                                        "text": "#form_text",
                                                        "font_type": "MinecraftTenEmoticon",
                                                        "font_size": "normal",
                                                        "font_scale_factor": 1.0,
                                                        "shadow": true,
                                                        "size": ["100%", "default"],
                                                        "anchor_from": "top_left",
                                                        "anchor_to": "top_left",
                                                        "offset": ["6%",-1],
                                                        "layer": 8,
                                                        "bindings": [
                                                            {
                                                                "binding_name": "#form_text",
                                                                "binding_type": "global"
                                                            }
                                                        ]
                                                    }
                                                }
                                            ]
                                        }
                                    }
                                ]
                            }
                        },
                        {
                            "contents": {
                                "type": "stack_panel",
                                "orientation": "vertical",
                                "anchor_from": "left_middle",
                                "anchor_to": "left_middle",
                                "offset": ["2.5%","-1.5%"],
                                "size": ["95%","100%c"],

                                "factory": {
                                    "name": "buttons",
                                    "control_ids": {
                                        "button": "dark_ui.dark_button",
                                        "label": "dark_ui.dark_label"
                                    }
                                },

                                "collection_name": "form_buttons",
                                "bindings": [
                                    {
                                        "binding_name": "#form_button_contents",
                                        "binding_name_override": "#collection_length"
                                    }
                                ]
                            }
                        }
                    ]
                }
            }
        ]
    }
}